{
  "name": "garden",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '@garden/backend' dev & bun run --filter '@garden/frontend' dev",
    "dev:backend": "bun run --filter '@garden/backend' dev",
    "dev:frontend": "bun run --filter '@garden/frontend' dev",
    "build": "bun run --filter '@garden/frontend' build",
    "prepare": "lefthook install",
    "lint": "oxlint --config .oxlintrc.json --ignore-pattern 'frontend/.svelte-kit/**' packages/ backend/ frontend/src/",
    "format": "oxfmt --write 'packages/' 'backend/' 'frontend/src/' 'frontend/e2e/' 'frontend/*.ts' 'frontend/*.js' 'frontend/*.json' && bun run --filter '@garden/frontend' format:svelte",
    "format:check": "oxfmt --check 'packages/' 'backend/' 'frontend/src/' 'frontend/e2e/' 'frontend/*.ts' 'frontend/*.js' 'frontend/*.json' && bun run --filter '@garden/frontend' format:svelte:check",
    "typecheck": "tsc --noEmit --project packages/schema/tsconfig.json && tsc --noEmit --project packages/dto/tsconfig.json && tsc --noEmit --project packages/mock/tsconfig.json && tsc --noEmit --project backend/tsconfig.json && cd frontend && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "lefthook": "^2.1.3",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod-schema-faker": "^2.1.0"
  }
}
